# Portfolio admin server (internal)

PORT=5173
NODE_ENV=development

# Super-admin login (hashed on first run into data/admin-auth.json — never commit plaintext)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Long random string for session cookies
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Comma-separated browser origins allowed to call /api with credentials (GitHub Pages admin UI).
# In production, defaults to https://nplmedmarketing-collab.github.io when unset.
# ADMIN_CORS_ORIGINS=https://nplmedmarketing-collab.github.io
