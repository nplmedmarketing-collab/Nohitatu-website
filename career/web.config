<?xml version="1.0" encoding="UTF-8"?>
<!--
  Legacy Angular career SPA still lives under /career/ on the live host.
  Redirect apply links to the current static PostResume flow before any SPA fallback.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Legacy PostResume id to modern apply" stopProcessing="true">
          <match url="^PostResume/(\d+)/?$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" />
          </conditions>
          <action type="Redirect" url="/PostResume?id={R:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Legacy PostResume to Careers" stopProcessing="true">
          <match url="^PostResume/?$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" />
          </conditions>
          <action type="Redirect" url="/Careers" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Legacy career root to Careers" stopProcessing="true">
          <match url="^$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" />
          </conditions>
          <action type="Redirect" url="/Careers" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Legacy career paths to Careers" stopProcessing="true">
          <match url="^.+$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" />
          </conditions>
          <action type="Redirect" url="/Careers" redirectType="Permanent" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
