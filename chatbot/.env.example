# Required for live LLM replies
OPENAI_API_KEY=

# Optional overrides
OPENAI_MODEL=gpt-4o-mini
APP_ENV=development
PORT=8010

# Comma-separated extra CORS origins (e.g. staging previews)
# CORS_EXTRA_ORIGINS=https://staging.example.com

# Widget side (set in page JS or window.NOHI_CHAT_API, not required by backend):
# CHAT_API_URL=http://localhost:8010
